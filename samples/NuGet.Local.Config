<configuration>
  <packageSources>
    <clear />
    <add key="orelay-local" value="../.artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="orelay-local"><package pattern="ORelay.Aspire.Hosting" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
